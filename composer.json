{
    "name": "shlinkio/shlink-common",
    "type": "project",
    "homepage": "https://shlink.io",
    "description": "Common tools used by Shlink",
    "license": "MIT",
    "authors": [
        {
            "name": "Alejandro Celaya Alastrué",
            "homepage": "https://www.alejandrocelaya.com",
            "email": "alejandro@alejandrocelaya.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-fileinfo": "*",
        "cakephp/chronos": "^3.4",
        "cuyz/valinor": "^2.4",
        "doctrine/orm": "^3.6",
        "fig/http-message-util": "^1.1",
        "guzzlehttp/guzzle": "^7.10",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-servicemanager": "^4.5 || ^3.24",
        "lcobucci/jwt": "^5.6",
        "monolog/monolog": "^3.10",
        "php-amqplib/php-amqplib": "^3.7",
        "predis/predis": "^3.5.1",
        "psr/http-server-middleware": "^1.0",
        "ramsey/uuid": "^4.9",
        "respect/validation": "^2.4",
        "shlinkio/shlink-config": "^4.1",
        "shlinkio/shlink-json": "^1.3",
        "symfony/cache": "^8.0",
        "symfony/lock": "^8.0",
        "symfony/mercure": "^0.7",
        "symfony/translation-contracts": "^3.6"
    },
    "require-dev": {
        "akrabat/ip-address-middleware": "^2.6",
        "carthage-software/mago": "^1.28",
        "devster/ubench": "^2.1",
        "laminas/laminas-stratigility": "^4.3",
        "mezzio/mezzio-problem-details": "^1.19",
        "pagerfanta/core": "^3.8",
        "phpunit/phpunit": "^13.0",
        "psr/simple-cache": "^3.0",
        "shlinkio/shlink-mago-config": "^1.1",
        "symfony/string": "^8.0",
        "symfony/var-dumper": "^8.0"
    },
    "suggest": {
        "mezzio/mezzio-problem-details": "To log ProblemDetailsMiddleware errors using the ErrorLogger",
        "laminas/laminas-stratigility": "To log ErrorHandler errors using the ErrorLogger",
        "pagerfanta/core": "To use the PagerfantaUtils"
    },
    "autoload": {
        "psr-4": {
            "Shlinkio\\Shlink\\Common\\": "src"
        },
        "files": [
            "functions/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ShlinkioTest\\Shlink\\Common\\": "test"
        }
    },
    "scripts": {
        "ci": [
            "@cs",
            "@analyze",
            "@test:ci"
        ],
        "lint": "mago lint",
        "lint:fix": "mago lint --fix",
        "format": "mago format",
        "format:check": "mago format --check",
        "cs": ["@lint", "@format:check"],
        "cs:fix": ["@lint:fix", "@format"],
        "analyze": "mago analyze",
        "stan": "@analyze",
        "test": "phpunit --order-by=random --testdox --testdox-summary",
        "test:ci": "XDEBUG_MODE=coverage composer test -- --coverage-clover=build/clover.xml",
        "test:pretty": "XDEBUG_MODE=coverage composer test -- --coverage-html=build/coverage-html"
    },
    "scripts-descriptions": {
        "ci": "<fg=blue;options=bold>Alias for \"cs\", \"stan\" and \"test:ci\"</>",
        "cs": "<fg=blue;options=bold>Checks coding styles</>",
        "cs:fix": "<fg=blue;options=bold>Fixes coding styles, when possible</>",
        "analyze": "<fg=blue;options=bold>Inspects code with Mago analyze</>",
        "test": "<fg=blue;options=bold>Runs unit tests with no coverage reports</>",
        "test:ci": "<fg=blue;options=bold>Runs unit tests generating coverage reports and logs</>",
        "test:pretty": "<fg=blue;options=bold>Runs unit tests generating coverage reports in html</>"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
